{
  "name": "stream-thing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "eslint --fix src && prettier --write .",
    "postinstall": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && pnpm db:generate",
    "db:reset": "prisma migrate reset && pnpm db:push",
    "db:studio": "prisma studio --port 5555 --browser none"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@livekit/components-react": "^2.9.24",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.2.4",
    "@uploadthing/react": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jwt-decode": "^4.0.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scrollyfills": "^1.0.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "uploadthing": "^7.7.4",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  }
}
